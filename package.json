{
  "name": "modbus2mqtt",
  "version": "1.0.0",
  "description": "Modbus (TCP / RTU-over-TCP / Serial) to MQTT bridge with Zigbee2MQTT protocol compatibility and ThingsBoard + Windfront-inspired Web UI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:frontend": "pnpm --filter modbus2mqtt-frontend dev",
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "pnpm --filter modbus2mqtt-frontend build",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter modbus2mqtt-frontend typecheck",
    "test": "tsx --test tests/*.test.ts",
    "check:guardrails": "node scripts/check-ui-guardrails.mjs"
  },
  "keywords": [
    "modbus",
    "mqtt",
    "zigbee2mqtt",
    "thingsboard",
    "iot",
    "bridge"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "modbus-serial": "^8.0.21",
    "mqtt": "^5.10.4",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
